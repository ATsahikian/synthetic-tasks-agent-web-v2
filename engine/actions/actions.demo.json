{
  "schema_version": 1,
  "actions": {
    "prepare": {
      "handler": "action_command",
      "runner": {
        "argv": [
          "python3",
          "-c",
          "print('Prepared task')"
        ]
      }
    },
    "process": {
      "handler": "action_command",
      "runner": {
        "argv": [
          "python3",
          "-c",
          "print('Processed task')"
        ]
      }
    },
    "summarize": {
      "handler": "action_command",
      "runner": {
        "argv": [
          "python3",
          "-c",
          "print('Summarized task')"
        ]
      }
    }
  }
}
